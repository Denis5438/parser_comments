# 1. ОБЯЗАТЕЛЬНО: Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Сервисный ключ доступа ВКонтакте (для розыгрышей в VK)
# Создается бесплатно за 1 минуту в vk.com/dev -> Создать приложение -> Настройки
VK_SERVICE_TOKEN=your_vk_service_token_here

# 3. НЕ ОБЯЗАТЕЛЬНО: YouTube API Key (по умолчанию YouTube работает БЕЗ ключа через Innertube)
YOUTUBE_API_KEY=

# 4. НЕ ОБЯЗАТЕЛЬНО: Instagram Session ID (по умолчанию открытые посты работают БЕЗ него)
INSTAGRAM_SESSION_ID=

# 5. НЕ ОБЯЗАТЕЛЬНО: Порт для Render / UptimeRobot (по умолчанию 3000, Render задает сам)
PORT=3000

# 6. НЕ ОБЯЗАТЕЛЬНО: Автоочистка диска от Excel-файлов
# Папка для сохранения отчетов (по умолчанию temp/downloads)
DOWNLOADS_DIR=temp/downloads
# Порог удаления файлов в минутах (по умолчанию 30 минут)
EXCEL_MAX_AGE_MINUTES=30
# Интервал проверки очистки в минутах (по умолчанию 15 минут)
CLEANUP_INTERVAL_MINUTES=15
